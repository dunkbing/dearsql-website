---
import Layout from "../../layouts/Layout.astro";
import { CHECKED, competitors } from "../../data/comparisons";
---

<Layout
  title="Compare DearSQL — vs TablePlus, DBeaver, DataGrip, Navicat & More"
  description="See how DearSQL compares to TablePlus, DBeaver, DataGrip, Beekeeper Studio, DbGate and Navicat on features, performance, database support, and pricing."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Compare", url: "/compare" },
  ]}
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: competitors.map((c) => ({
        "@type": "Question",
        name: `How does DearSQL compare to ${c.name}?`,
        acceptedAnswer: { "@type": "Answer", text: c.summary },
      })),
    })}
  />

  <main class="max-w-2xl mx-auto px-4 py-6 text-sm">
    <h1 class="text-xl font-bold mb-1 before:content-['##_']">Compare DearSQL</h1>
    <p class="text-subtext0 text-xs mb-6">
      See how DearSQL stacks up against other popular database clients on features, performance, and pricing.
    </p>

    <div class="space-y-3">
      {competitors.map((c) => (
        <a
          href={`/compare/${c.id}`}
          class="block border border-surface1 bg-surface0 hover:bg-surface1 no-underline"
        >
          <div class="px-3 py-2 border-b border-surface1 flex items-center justify-between">
            <span>
              <span class="font-bold text-green">DearSQL</span>
              <span class="text-subtext0"> vs </span>
              <span class="font-bold text-text">{c.name}</span>
            </span>
            <span class="text-subtext0 text-xs">compare &rarr;</span>
          </div>
          <p class="px-3 py-2 text-subtext0 text-xs">{c.summary}</p>
        </a>
      ))}
    </div>

    <p class="text-xs text-subtext0 mt-6">
      * Last checked <time datetime={CHECKED.iso}>{CHECKED.label}</time>; sources are linked on each page. Got a correction?{" "}
      <a href="mailto:dunkbingg@gmail.com">let us know</a>.
    </p>
  </main>
</Layout>
